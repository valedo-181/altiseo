# Altiseo : copier en .env.local et remplir. Sans ces valeurs, l'application tourne en mode démo.
# Ne jamais mettre de vraies valeurs dans ce fichier : il est versionné.

# Adresse publique de l'application (liens de connexion envoyés par e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Région conseillée : Central EU (Frankfurt) ou Zurich.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur seulement (jamais NEXT_PUBLIC_). Sert aux écritures réservées au serveur.
SUPABASE_SERVICE_ROLE_KEY=

# Chiffrement des identifiants WordPress : 32 octets en base64 → openssl rand -base64 32
# Sans elle, la connexion WordPress reste simulée.
ENCRYPTION_KEY=

# Claude (console.anthropic.com → API Keys). Sans elle, les articles sont des textes d'exemple.
ANTHROPIC_API_KEY=

# Google Search Console (suivi des mots-clés). console.cloud.google.com → API et services → Identifiants →
# ID client OAuth « Application Web ». URI de redirection : <adresse>/app/mots-cles/google/callback
# Demande aussi ENCRYPTION_KEY. Sans elles, la page Mots-clés montre des chiffres d'exemple.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mode démo seulement : secret des cookies de session (32 caractères au moins) en production,
# ou ALTISEO_DEMO=1 pour une démo locale avec `next start`.
ALTISEO_SESSION_SECRET=
# ALTISEO_DEMO=1
# ALTISEO_DEMO_FILE=.data/demo.json

# À venir : DATAFORSEO_LOGIN, DATAFORSEO_PASSWORD, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY, CRON_SECRET
